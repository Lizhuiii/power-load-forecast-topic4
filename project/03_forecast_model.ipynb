    "plt.rcParams[\"figure.dpi\"] = 110\n",
    "plt.rcParams[\"savefig.bbox\"] = \"tight\"\n",
    "plt.rcParams[\"axes.grid\"] = True\n",
    "plt.rcParams[\"grid.alpha\"] = 0.25\n",
    "\n",
    "SEED = 42\n",
    "np.random.seed(SEED)\n",
