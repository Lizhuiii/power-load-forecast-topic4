   "source": [
    "## 步骤 4　模型设计\n",
    "\n",
    "三个对照，从弱到强：\n",
    "\n",
    "| 模型 | 作用 | 关键设置 |\n",
    "|---|---|---|\n",
    "| **持续性基线**（persistence） | 最\"笨\"的基准：直接拿前一日同时刻的值当预测。任何模型如果赢不了它，就没有存在价值 | `ŷ_t = y_{t−144}` |\n",
    "| **线性回归** | 可解释的基线。系数能直接读出\"某特征变化 1 单位，负荷变化多少\" | sklearn `LinearRegression` |\n",
    "| **随机森林** | 捕捉非线性与特征交互（如\"高温 + 工作日\"的叠加效应） | 100 棵树，`max_depth=16`，`min_samples_leaf=4`，`random_state=42` |\n",
    "\n",
    "**为什么要设持续性基线**：负荷的日周期非常强，\"昨天同一时刻\"本身就是一个相当准的预测。如果不跟它比，只看 R²=0.95 很容易误以为模型很厉害——实际上可能只比\"抄昨天\"好一点点。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "ae6e41be",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "训练总负荷模型 ...\n",
      "完成。\n"
     ]
    }
   ],
   "source": [
    "def evaluate(name, y_true, y_pred):\n",
    "    '''统一评估口径。'''\n",
    "    mse = mean_squared_error(y_true, y_pred)\n",
    "    rmse = np.sqrt(mse)\n",
    "    mae = mean_absolute_error(y_true, y_pred)\n",
    "    r2 = r2_score(y_true, y_pred)\n",
    "    mape = float(np.mean(np.abs((np.asarray(y_true) - np.asarray(y_pred)) / np.asarray(y_true))) * 100)\n",
    "    return {\"模型\": name, \"MSE\": mse, \"RMSE\": rmse, \"MAE\": mae, \"R²\": r2, \"MAPE(%)\": mape}\n",
    "\n",
    "\n",
    "def fit_and_eval(target):\n",
    "    '''对指定目标完成 特征构造 → 切分 → 三模型训练与评估。'''\n",
    "    Xa, ya = build_features(df, target)\n",
    "    ok = Xa.notna().all(axis=1)\n",
    "    Xa, ya = Xa[ok], ya[ok]\n",
    "    tr = Xa.index < SPLIT_DATE\n",
    "\n",
    "    Xtr, Xte = Xa[tr], Xa[~tr]\n",
    "    ytr, yte = ya[tr], ya[~tr]\n",
    "\n",
    "    results = {}\n",
    "    preds = {}\n",
    "\n",
    "    # 1) 持续性基线：前一日同时刻\n",
    "    p_persist = Xte[\"lag_144\"].values\n",
    "    results[\"持续性基线\"] = evaluate(\"持续性基线\", yte, p_persist)\n",
    "    preds[\"持续性基线\"] = p_persist\n",
    "\n",
    "    # 2) 线性回归\n",
    "    lr = LinearRegression()\n",
    "    lr.fit(Xtr, ytr)\n",
    "    p_lr = lr.predict(Xte)\n",
    "    results[\"线性回归\"] = evaluate(\"线性回归\", yte, p_lr)\n",
    "    preds[\"线性回归\"] = p_lr\n",
    "\n",
    "    # 3) 随机森林\n",
    "    rf = RandomForestRegressor(\n",
    "        n_estimators=100, max_depth=16, min_samples_leaf=4,\n",
    "        n_jobs=N_JOBS, random_state=SEED,\n",
    "    )\n",
    "    rf.fit(Xtr, ytr)\n",
    "    p_rf = rf.predict(Xte)\n",
    "    results[\"随机森林\"] = evaluate(\"随机森林\", yte, p_rf)\n",
    "    preds[\"随机森林\"] = p_rf\n",
    "\n",
    "    return {\n",
    "        \"target\": target, \"results\": results, \"preds\": preds,\n",
    "        \"y_test\": yte, \"X_test\": Xte, \"X_train\": Xtr, \"y_train\": ytr,\n",
    "        \"lr\": lr, \"rf\": rf, \"features\": list(Xa.columns),\n",
    "    }\n",
    "\n",
    "\n",
    "print(\"训练总负荷模型 ...\")\n",
    "main = fit_and_eval(TARGET_TOTAL)\n",
    "print(\"完成。\")"
   ]
  },
