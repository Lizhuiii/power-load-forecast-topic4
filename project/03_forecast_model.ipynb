    "FEATURE_SETS = {\n",
    "    \"S1 仅时间+气象\": [c for c in main[\"features\"]\n",
    "                   if c not in (\"lag_144\", \"lag_1008\", \"roll_day_mean\", \"roll_day_std\", \"roll_week_mean\")],\n",
    "    \"S2 +lag_144\": [c for c in main[\"features\"]\n",
    "                    if c not in (\"lag_1008\", \"roll_day_mean\", \"roll_day_std\", \"roll_week_mean\")],\n",
    "    \"S3 全部特征\": list(main[\"features\"]),\n",
    "}\n",
    "\n",
    "Xtr_main, Xte_main = main[\"X_train\"], main[\"X_test\"]\n",
    "ytr_main, yte_main = main[\"y_train\"], main[\"y_test\"]\n",
    "\n",
    "print(\"各配置特征数:\", {k: len(v) for k, v in FEATURE_SETS.items()})\n",
    "\n",
    "abl_rows = []\n",
    "abl_preds = {}\n",
    "for set_name, cols in FEATURE_SETS.items():\n",
    "    lr = LinearRegression().fit(Xtr_main[cols], ytr_main)\n",
    "    p_lr = lr.predict(Xte_main[cols])\n",
    "\n",
    "    rf = RandomForestRegressor(\n",
    "        n_estimators=100, max_depth=16, min_samples_leaf=4,\n",
    "        n_jobs=N_JOBS, random_state=SEED,\n",
    "    ).fit(Xtr_main[cols], ytr_main)\n",
    "    p_rf = rf.predict(Xte_main[cols])\n",
    "\n",
    "    for model_name, pred in [(\"线性回归\", p_lr), (\"随机森林\", p_rf)]:\n",
    "        r = evaluate(model_name, yte_main, pred)\n",
    "        r[\"特征配置\"] = set_name\n",
    "        r[\"特征数\"] = len(cols)\n",
    "        abl_preds[(set_name, model_name)] = pred\n",
    "        abl_rows.append(r)\n",
    "\n",
    "ablation = pd.DataFrame(abl_rows)[[\"特征配置\", \"特征数\", \"模型\", \"RMSE\", \"MAE\", \"R²\", \"MAPE(%)\"]]\n",
    "base_r2 = ablation.loc[ablation[\"特征配置\"] == \"S1 仅时间+气象\", \"R²\"].max()\n",
    "ablation[\"相对S1最优R²提升\"] = (ablation[\"R²\"] - base_r2).round(4)\n",
    "\n",
    "display(ablation.round(4).set_index([\"特征配置\", \"模型\"]))"
   ]
  },
