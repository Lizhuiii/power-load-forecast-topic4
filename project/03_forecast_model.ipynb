    "abl_preds = {}\n",
    "for set_name, cols in FEATURE_SETS.items():\n",
    "    lr = LinearRegression().fit(Xtr_main[cols], ytr_main)\n",
    "    p_lr = lr.predict(Xte_main[cols])\n",
    "\n",
    "    rf = RandomForestRegressor(\n",
    "        n_estimators=100, max_depth=16, min_samples_leaf=4,\n",
    "        n_jobs=N_JOBS, random_state=SEED,\n",
    "    ).fit(Xtr_main[cols], ytr_main)\n",
    "    p_rf = rf.predict(Xte_main[cols])\n",
    "\n",
    "    for model_name, pred in [(\"线性回归\", p_lr), (\"随机森林\", p_rf)]:\n",
    "        r = evaluate(model_name, yte_main, pred)\n",
    "        r[\"特征配置\"] = set_name\n",
    "        r[\"特征数\"] = len(cols)\n",
    "        abl_preds[(set_name, model_name)] = pred\n",
