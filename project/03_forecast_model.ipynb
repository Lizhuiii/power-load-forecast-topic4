   "source": [
    "TARGET_TOTAL = \"zone_total_power_consumption\"\n",
    "ZONE_COLS = [\"zone1_power_consumption\", \"zone2_power_consumption\", \"zone3_power_consumption\"]\n",
    "WEATHER_COLS = [\"temperature\", \"humidity\", \"wind_speed\", \"general_diffuse_flows\", \"diffuse_flows\"]\n",
    "\n",
    "LAG_DAY = 144     # 一天 = 144 个 10 分钟点\n",
    "LAG_WEEK = 1008   # 一周 = 1008 个点\n",
    "\n",
    "\n",
    "def build_features(frame, target):\n",
    "    '''构造特征矩阵 X 与目标 y。所有负荷类特征均滞后 >= LAG_DAY。'''\n",
    "    idx = frame.index\n",
    "    X = pd.DataFrame(index=idx)\n",
    "\n",
    "    # --- 时间特征 ---\n",
    "    X[\"hour\"] = idx.hour\n",
    "    X[\"slot\"] = idx.hour * 6 + idx.minute // 10\n",
    "    X[\"dayofweek\"] = idx.dayofweek\n",
    "    X[\"is_weekend\"] = (idx.dayofweek >= 5).astype(int)\n",
    "    X[\"month\"] = idx.month\n",
    "    X[\"dayofyear\"] = idx.dayofyear\n",
    "\n",
    "    # --- 周期三角编码 ---\n",
    "    X[\"sin_day\"] = np.sin(2 * np.pi * X[\"slot\"] / 144)\n",
    "    X[\"cos_day\"] = np.cos(2 * np.pi * X[\"slot\"] / 144)\n",
    "    X[\"sin_week\"] = np.sin(2 * np.pi * X[\"dayofweek\"] / 7)\n",
    "    X[\"cos_week\"] = np.cos(2 * np.pi * X[\"dayofweek\"] / 7)\n",
    "    X[\"sin_year\"] = np.sin(2 * np.pi * X[\"dayofyear\"] / 365)\n",
    "    X[\"cos_year\"] = np.cos(2 * np.pi * X[\"dayofyear\"] / 365)\n",
    "\n",
    "    # --- 滞后与历史统计（全部滞后 >= 144 点，防止泄漏）---\n",
    "    y = frame[target]\n",
    "    X[\"lag_144\"] = y.shift(LAG_DAY)\n",
    "    X[\"lag_1008\"] = y.shift(LAG_WEEK)\n",
    "    X[\"roll_day_mean\"] = y.rolling(LAG_DAY, min_periods=LAG_DAY).mean().shift(LAG_DAY)\n",
    "    X[\"roll_day_std\"] = y.rolling(LAG_DAY, min_periods=LAG_DAY).std().shift(LAG_DAY)\n",
    "    X[\"roll_week_mean\"] = y.rolling(LAG_WEEK, min_periods=LAG_WEEK).mean().shift(LAG_DAY)\n",
    "\n",
    "    # --- 气象（实测值）---\n",
    "    for c in WEATHER_COLS:\n",
    "        X[c] = frame[c]\n",
    "\n",
    "    return X, y\n",
    "\n",
    "\n",
    "X_all, y_all = build_features(df, TARGET_TOTAL)\n",
    "print(f\"特征矩阵: {X_all.shape}\")\n",
    "print(f\"特征列表: {list(X_all.columns)}\")\n",
    "print(f\"\\n含缺失的行数（来自 lag_1008 预热期）: {int(X_all.isna().any(axis=1).sum())}\")\n",
    "display(X_all.head(3).round(3))"
   ]
